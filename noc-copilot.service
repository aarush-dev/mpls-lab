[Unit]
Description=NOC copilot runtime (api + PA-emulator predictor + forensic trigger)
# The lab (containerlab + telemetry + dataapi) must be up first: copilot-up.sh preflights
# dataapi :8000 and fails fast if it is absent. noc-lab.service is the oneshot that brings it up.
Requires=noc-lab.service
After=noc-lab.service

[Service]
Type=oneshot
RemainAfterExit=yes
# copilot-up.sh nohup-backgrounds the 3 procs then waits one predict interval for the heartbeat;
# generous but bounded start.
TimeoutStartSec=120
# Only signal the main script on stop. The nohup'd + disown'd api/predictor/trigger are reparented
# out of this unit's cgroup, so `systemctl stop` does NOT signal them -- each has a SIGTERM handler
# but it only fires on a direct `pkill`. They leak across a service stop (same silent-lifecycle gap
# the per-proc-unit ceiling below fixes). ponytail: acceptable for the demo; stop procs via pkill.
KillMode=process
ExecStart=/root/LAB/copilot-up.sh

# ponytail: no Restart= — matches the house nohup style (dataapi in noc-lab.service is the same).
# If a proc dies mid-run, systemd will NOT notice (oneshot + RemainAfterExit) and the pipeline goes
# silently dead until the next manual copilot-up.sh. Ceiling: split into 3 per-proc units
# (noc-copilot-api/predictor/trigger.service) with Type=simple + Restart=always for auto-recovery.

[Install]
WantedBy=multi-user.target
