# App-config knobs for the mplslab-noccopilot-app plugin.
#
# NOTE: the default docker-compose.yml stack runs in MOCK mode and
# does not read these values at all — mock mode generates its own
# in-memory data and ignores APP_MODE/API_BASE_URL/REQUEST_TIMEOUT_MS.
# They are documented here for a future "api" mode that talks to a
# real backend.

# mock | api
APP_MODE=mock

# Base URL of the backend API (only used when APP_MODE=api)
API_BASE_URL=http://127.0.0.1:8000

# Request timeout, in milliseconds (only used when APP_MODE=api)
REQUEST_TIMEOUT_MS=8000
