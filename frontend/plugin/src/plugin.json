{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "NOC Copilot",
  "id": "mplslab-noccopilot-app",
  "preload": true,
  "info": {
    "keywords": ["app", "noc", "copilot"],
    "description": "NOC Copilot",
    "author": {
      "name": "mplslab"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Overview",
      "path": "/a/%PLUGIN_ID%/",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Topology",
      "path": "/a/%PLUGIN_ID%/topology",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Node Detail",
      "path": "/a/%PLUGIN_ID%/node/1",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Telemetry",
      "path": "/a/%PLUGIN_ID%/telemetry",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Incidents",
      "path": "/a/%PLUGIN_ID%/incidents",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Copilot",
      "path": "/a/%PLUGIN_ID%/copilot",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Status",
      "path": "/a/%PLUGIN_ID%/status",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.1.0",
    "plugins": []
  }
}
