# Third-party reuse repos (cloned reference labs, not our source)
refs/

# Generated lab output (reproduce with: python3 generator/generate.py)
# Also contains WireGuard private keys — keep out of git.
topology/

# WireGuard keypair cache (secrets)
generator/.wg-keys.json

# Generated fault label timelines (runtime output; schema documented in faults/README.md)
faults/labels/

# Generated datasets (Parquet exports — reproduce via dataapi/export.py / synthetic/generate.py)
dataapi/datasets/
synthetic/output/

# Air-gap image bundles (large; produced by airgap/pull-and-save.sh)
airgap/images/

# Secrets — copilot backend API keys (template: copilot/.env.example)
.env
copilot/.env

# Copilot runtime state (R2a session store / R2b event ledger / cases) — per-run, not source
sessions/
cases/
ledger.db
copilot/sessions/
copilot/cases/
copilot/ledger.db
forensic-cursor.json
copilot/forensic-cursor.json

# Python / tooling cruft
__pycache__/
*.pyc
*.log

# Node modules
node_modules/

# Windows WSL artifacts
*:Zone.Identifier

# streaming: python bytecode only; bridge.py/consume.py are source
streaming/__pycache__/

# PA (predictive-analysis) repo + weights — lives on VM/Modal, never in lab git
bah_predictive_analysis/
._*
scratchpad/
.agents/
