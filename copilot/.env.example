# copilot secrets -- copy to copilot/.env (gitignored) and fill in.
# Read by copilot/config.py via python-dotenv; NEVER commit the real .env.
# ADR-0004: API keys live here / in the environment, never in config.yaml or git.

# Backend API key for the `nim` profile (NVIDIA NIM). Empty on `unsloth-local`.
COPILOT_LLM_API_KEY=
# Embedder API key when embed_profile=nim. Empty when embedding locally.
COPILOT_EMBED_API_KEY=

# A1: dataapi base URL the HttpAdapter reads. Optional -- overrides config.yaml's
# dataapi_url (default http://127.0.0.1:8000) when the stack runs off-localhost.
# COPILOT_DATAAPI_URL=http://127.0.0.1:8000
