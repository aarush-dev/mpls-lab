# copilot secrets + backend endpoints -- copy to copilot/.env (gitignored) and fill in.
# Read by copilot/config.py via python-dotenv; NEVER commit the real .env.
# ADR-0004: API keys live here / in the environment, never in config.yaml or git.

# Backend API key for the `nim` profile (NVIDIA NIM). Empty on `unsloth-local`.
COPILOT_LLM_API_KEY=
# Embedder API key when embed_profile=nim. Empty when embedding locally.
COPILOT_EMBED_API_KEY=

# -- nim profile against NVIDIA-hosted (E1 interim; NOT air-gapped, ADR-0004) --------
# LLM: OpenAI-compatible chat endpoint + model id. gpt-oss is a reasoning model, so set
# the effort tier explicitly (low|medium|high) -- unset omits it (plain OpenAI body).
# COPILOT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# COPILOT_LLM_MODEL_NIM=openai/gpt-oss-20b
# COPILOT_LLM_REASONING_EFFORT=high
# Embeddings: NVIDIA nv-embedqa REJECTS the plain OpenAI body -- it needs input_type
# (+truncate). Unset both -> plain OpenAI shape (a local/plain server).
# COPILOT_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
# COPILOT_EMBED_MODEL_NIM=nvidia/nv-embedqa-e5-v5
# COPILOT_EMBED_INPUT_TYPE=query
# COPILOT_EMBED_TRUNCATE=END

# -- gemma profile: on-prem gemma-4, OpenAI-compatible, keyless ---------------------
# Switch to it with one line: llm_profile: gemma in config.yaml. Own base-url var so a
# hosted nim .env's COPILOT_LLM_BASE_URL can't hijack this profile.
# COPILOT_LLM_BASE_URL_GEMMA=http://10.0.0.5:8888/v1
# COPILOT_LLM_MODEL_GEMMA=mtp-gemma-4-26B-A4B-it-Q8_0

# A1: dataapi base URL the HttpAdapter reads. Optional -- overrides config.yaml's
# dataapi_url (default http://127.0.0.1:8000) when the stack runs off-localhost.
# COPILOT_DATAAPI_URL=http://127.0.0.1:8000
