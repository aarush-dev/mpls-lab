{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOC copilot ML dataset row",
  "description": "One row per (device, entity, entity_type, ts-bucket) in the joined labeled Parquet emitted by export.py. Metric columns are nullable per entity_type. Enforced by check_dataset.py.",
  "type": "object",
  "required": ["ts", "device", "entity", "entity_type", "is_fault"],
  "properties": {
    "ts":                {"type": "string", "description": "UTC ISO-8601 …Z bucket start"},
    "device":            {"type": "string", "description": "node name — join key"},
    "site_type":         {"type": ["string", "null"], "enum": ["branch", "hub", "dc", "core", "pe", null]},
    "vrf":               {"type": ["string", "null"], "description": "VRF name on CE vrf_* pseudo-interfaces; null elsewhere"},
    "entity":            {"type": "string", "description": "interface name, tunnel id, or the device name on entity_type=device rows"},
    "entity_type":       {"type": "string", "enum": ["interface", "tunnel", "device"]},

    "if_in_octets":      {"type": ["number", "null"]},
    "if_out_octets":     {"type": ["number", "null"]},
    "if_oper_status":    {"type": ["number", "null"]},

    "tunnel_latency_ms": {"type": ["number", "null"]},
    "tunnel_jitter_ms":  {"type": ["number", "null"]},
    "tunnel_loss_pct":   {"type": ["number", "null"]},
    "tunnel_rekeys":     {"type": ["number", "null"]},

    "flow_bytes":        {"type": ["number", "null"], "description": "device-wide, carried on the entity_type=device row only"},
    "flow_packets":      {"type": ["number", "null"], "description": "device-wide, carried on the entity_type=device row only"},

    "is_fault":          {"type": "boolean"},
    "scenario_id":       {"type": ["string", "null"]},
    "fault_type":        {"type": ["string", "null"]},
    "severity":          {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "lead_time_s":       {"type": ["number", "null"]},
    "time_to_impact_s":  {"type": ["number", "null"]},

    "if_in_errors":      {"type": ["number", "null"]},
    "if_in_discards":    {"type": ["number", "null"]},
    "if_out_errors":     {"type": ["number", "null"]},
    "if_out_discards":   {"type": ["number", "null"]},
    "q_backlog_bytes":   {"type": ["number", "null"]},
    "q_drops":           {"type": ["number", "null"]},
    "xcvr_temp_c":       {"type": ["number", "null"]},
    "xcvr_rx_power_dbm": {"type": ["number", "null"]},
    "xcvr_tx_bias_ma":   {"type": ["number", "null"]},

    "cpu_pct":              {"type": ["number", "null"]},
    "mem_pct":              {"type": ["number", "null"]},
    "bgp_msg_rx":           {"type": ["number", "null"]},
    "bgp_msg_tx":           {"type": ["number", "null"]},
    "rib_routes":           {"type": ["number", "null"]},
    "ospf_lsa_count":       {"type": ["number", "null"]},
    "device_temp_c":        {"type": ["number", "null"]},
    "device_power_watts":   {"type": ["number", "null"]},
    "device_fan_rpm":       {"type": ["number", "null"]},
    "device_psu_voltage_v": {"type": ["number", "null"]}
  }
}
